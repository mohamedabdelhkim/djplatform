# Security headers for every response. Cloudflare Pages reads this file from the
# build output root. Deliberately conservative: no script-src or default-src,
# because Next.js hydration relies on inline scripts and a wrong value here
# breaks the site silently in the browser rather than at build time.
#
# The last line detaches Access-Control-Allow-Origin, which Cloudflare Pages
# attaches to static assets on its own. Removing it grants nothing and protects
# nothing: the pages are public, the site sets no cookies, and the booking
# Function sends no CORS headers at all, so anyone wanting the HTML fetches it
# server-side where CORS does not apply. It goes because scanners flag it as a
# permissive CORS policy, and a report full of known noise is a report where a
# real finding goes unnoticed.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  ! Access-Control-Allow-Origin

# Next emits generated metadata images with no file extension, so Cloudflare has
# nothing to infer a MIME type from and serves them as application/octet-stream.
# The page's own og:image:type says image/png, and the consumers that matter -
# WhatsApp, Slack, Twitter, iOS - trust the response header over the meta tag,
# so without these two lines the share card is fetched and then discarded.
# Verified against the live response, not assumed: both served octet-stream.
/opengraph-image
  Content-Type: image/png

/apple-icon
  Content-Type: image/png
